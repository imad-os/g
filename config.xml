<?xml version="1.0" encoding="UTF-8"?>
<!-- Samsung TV (Tizen) web app configuration. Checked against the Seller Office launch checklist:
     - <name> must be identical to the default-language title entered in Seller Office.
     - version [0-255].[0-255].[0-65535]; every new upload needs a higher version.
     - <icon>: 512x423 PNG (24-bit) under 300 KB, in the package root.
     - screen size declared with a <feature>; only the privileges actually used.
     - XXXXXXXXXX = the 10-character package ID from Seller Office / Certificate Manager. The
       tizen:application id is "<package>.<name>" and must never change between versions.
     Every package upload needs a higher version. Never change SHELL in js/boot/loader.js or "shell" in
     app-manifest.json: older packages would stop accepting the online builds. -->
<widget xmlns="http://www.w3.org/ns/widgets" xmlns:tizen="http://tizen.org/ns/widgets"
        id="https://imad-os.github.io/g/arcade" version="1.5.0" viewmodes="maximized">
    <tizen:application id="XXXXXXXXXX.arcade" package="XXXXXXXXXX" required_version="4.0"/>
    <name>My PC</name>
    <description>Seven arcade and board games for your TV: a platformer with 3 worlds and 2-player co-op, Parchís for 2 to 4 players with Moroccan rules, plus falling blocks, sky hopping, snake, brick breaking and tile merging. Player profiles keep everyone's progress apart.</description>
    <icon src="icon.png" width="512" height="423"/>
    <content src="index.html"/>
    <feature name="http://tizen.org/feature/screen.size.all"/>
    <tizen:profile name="tv"/>
    <!-- WARP mode. Do NOT add tizen:allow-navigation (it switches the app to a strict CSP). -->
    <access origin="*" subdomains="true"/>
    <tizen:privilege name="http://tizen.org/privilege/internet"/>
    <tizen:privilege name="http://tizen.org/privilege/tv.inputdevice"/>
    <!-- webapis.network: network disconnection popup (mandatory in the Samsung checklist) -->
    <tizen:privilege name="http://developer.samsung.com/privilege/network.public"/>
    <!-- webapis.productinfo.getDuid(): the TV's own id, so a reinstalled My PC finds its cloud backup (js/core/backup.js) -->
    <tizen:privilege name="http://developer.samsung.com/privilege/productinfo"/>
    <tizen:setting screen-orientation="landscape" context-menu="disable" background-support="disable"
                   encryption="disable" install-location="auto" hwkey-event="enable"/>
    <tizen:metadata key="http://samsung.com/tv/metadata/multitasking.support" value="true"/>

    <!-- heart-rate sensors over Bluetooth LE (js/core/hr-ble.js). "bluetooth" is the current privilege (Tizen 3.0+); the two
         older ones are what some TV firmware still checks for the LE adapter. Added in package 1.4.0: a TV needs this package. -->
    <tizen:privilege name="http://tizen.org/privilege/bluetooth"/>
    <tizen:privilege name="http://tizen.org/privilege/bluetooth.admin"/>
    <tizen:privilege name="http://tizen.org/privilege/bluetooth.gap"/>
    <tizen:privilege name="http://tizen.org/privilege/application.launch"/>

    <!-- the microphone for installed apps (MyPC.mic, js/core/mic.js: getUserMedia in My PC, the sound goes to the app).
         Added in package 1.5.0: a TV needs this package for MyPC.mic (the rest of the update comes online). -->
    <tizen:privilege name="http://tizen.org/privilege/mediacapture"/>
</widget>
