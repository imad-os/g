                             { "id": "tips", "label": "Show tips", "type": "toggle", "default": true }] }],
  "touch": { "buttons": [{ "label": "A", "action": "ok", "place": "right" }, { "label": "B", "action": "b", "place": "bottom" }], "catalog": [{ "label": "A", "action": "ok", "place": "right" }, { "label": "B", "action": "b", "place": "bottom" }, { "label": "X", "action": "menu", "place": "top" }, { "label": "Y", "action": "run", "place": "left" }] }
