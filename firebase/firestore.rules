rules_version = '2';

// My PC (formerly Arcade): Firestore security rules.
//  - Anyone (the TVs) can READ the App Store catalog ("apps"). TVs never sign in.
//  - Only signed-in admins can publish / update / remove apps (App Store Manager, installer/index.html).
//  - TVs may write only small, checked things: +1 on an app's counters, their own backup document,
//    the world records (top 10 per game).
//  - An admin is a user whose UID has a document in /admins (created by hand in the console).
//  - Writes are validated so a mistake in the admin page cannot break every TV.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isAdmin() {
      return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // { en: '...', fr: '...', es: '...', ar: '...' }  (en required)
    function validText(t) {
      return t is map && t.keys().hasAll(['en']) && t.keys().hasOnly(['en', 'fr', 'es', 'ar'])
          && t.en is string && t.en.size() > 0 && t.en.size() <= 80;
    }

    function validGame(d) {
      return d.keys().hasAll(['title', 'url', 'enabled', 'order'])
          && d.keys().hasOnly(['title', 'description', 'url', 'cover', 'enabled', 'order', 'minShell',
                               'sdk', 'build', 'tags', 'bundled', 'updatedAt'])
          && validText(d.title)
          && (!('description' in d) || validText(d.description))
          // https only; bundled first-party games use a relative path like "games/jumper/"
          && d.url is string && d.url.size() <= 300
          && (d.url.matches('^https://[a-zA-Z0-9.-]+/.*') || d.url.matches('^games/[a-z0-9-]+/$'))
          && (!('cover' in d) || (d.cover is string && d.cover.size() <= 300))
          && d.enabled is bool
          && d.order is int && d.order >= 0 && d.order < 1000
          && (!('minShell' in d) || d.minShell is int)
          && (!('sdk' in d) || d.sdk is int)
          && (!('build' in d) || d.build is int)
          && (!('bundled' in d) || d.bundled is bool)
          && (!('tags' in d) || (d.tags is list && d.tags.size() <= 5))
          && (!('updatedAt' in d) || d.updatedAt is timestamp);
    }

    // Game list read by every TV (REST: .../documents/games)
    match /games/{gameId} {
      allow read: if true;
      allow create, update: if isAdmin() && gameId.matches('^[a-z0-9-]{2,32}$') && validGame(request.resource.data);
      allow delete: if isAdmin();
    }

    function httpsUrl(u) { return u is string && u.size() <= 400 && u.matches('^https://[a-zA-Z0-9.-]+(:[0-9]+)?/.*'); }

    // My PC installed apps (installer/index.html): an app or game built with the My PC SDK.
    function validApp(id, d) {
      return d.keys().hasAll(['id', 'name', 'url', 'entry', 'type', 'enabled', 'order'])
          && d.keys().hasOnly(['id', 'name', 'description', 'url', 'entry', 'icon', 'type', 'version', 'sdk',
                               'scores', 'enabled', 'order', 'installedAt', 'installedBy', 'config', 'touch', 'services', 'widgets'])
          && d.id == id
          && d.name is string && d.name.size() > 0 && d.name.size() <= 40
          && (!('description' in d) || (d.description is string && d.description.size() <= 120))
          && httpsUrl(d.url) && httpsUrl(d.entry)
          && (!('icon' in d) || d.icon == '' || httpsUrl(d.icon))
          && d.type in ['game', 'app']
          && (!('version' in d) || (d.version is string && d.version.size() <= 20))
          && (!('sdk' in d) || d.sdk is int)
          && (!('scores' in d) || d.scores is bool)
          && d.enabled is bool
          && d.order is int && d.order >= 0 && d.order < 1000
          && (!('installedAt' in d) || d.installedAt is timestamp)
          && (!('installedBy' in d) || d.installedBy is string)
          && (!('config' in d) || d.config is map)
          && (!('touch' in d) || (d.touch is bool && d.touch == false) || (d.touch is map && d.touch.size() <= 3))      // touch pad: false, or { buttons, catalog, scale }
          && (!('services' in d) || (d.services is list && d.services.size() <= 3))       // push notification services [{ id, file, every, title }]
          && (!('widgets' in d) || (d.widgets is list && d.widgets.size() <= 3));        // desktop widgets [{ id, title, file, size, every, background, settings, sha }]
    }

    // The App Store catalog, read by every TV (REST: .../documents/apps), written only by admins.
    match /apps/{appId} {
      allow read: if true;
      allow create, update: if isAdmin() && appId.matches('^[a-z0-9-]{2,32}$') && validApp(appId, request.resource.data);
      allow delete: if isAdmin();
    }

    // The AI services of every My PC (App Store Manager > AI services, js/core/ai.js): read by every TV at start,
    // written only by admins. Like the catalog, anyone can read it (TVs never sign in), keys included.
    function validAi(d) {
      return d.keys().hasOnly(['list', 'def', 'updatedAt', 'updatedBy'])
          && d.list is list && d.list.size() <= 20
          && (!('def' in d) || (d.def is string && d.def.size() <= 40))
          && (!('updatedAt' in d) || d.updatedAt is timestamp)
          && (!('updatedBy' in d) || (d.updatedBy is string && d.updatedBy.size() <= 120));
    }
    // Settings for every My PC (App Store Manager > Settings, js/core/global-settings.js): backgrounds added by admins
    // and the one new profiles get. Read by every TV at start.
    function validMyPc(d) {
      return d.keys().hasOnly(['wallpapers', 'wallpaper', 'notifyFast', 'events', 'webRelay', 'updatedAt', 'updatedBy'])
          && (!('webRelay' in d) || (d.webRelay is string && d.webRelay.size() <= 1000))          // the Browser's relay (web / phone only)
          && d.wallpapers is list && d.wallpapers.size() <= 40
          && (!('events' in d) || (d.events is list && d.events.size() <= 100))                // events on every calendar
          && (!('notifyFast' in d) || (d.notifyFast is list && d.notifyFast.size() <= 200))      // push notifications every 2 min
          && (!('wallpaper' in d) || (d.wallpaper is string && d.wallpaper.size() <= 1002))
          && (!('updatedAt' in d) || d.updatedAt is timestamp)
          && (!('updatedBy' in d) || (d.updatedBy is string && d.updatedBy.size() <= 120));
    }
    // The Google client of every My PC for Google Drive (App Store Manager > Google Drive, js/core/gdrive.js). Read by every
    // TV at start. A "TVs and Limited Input devices" client secret is not confidential for Google; the Picker key is
    // limited to the referrer https://imad-os.github.io/g/*.
    function validGoogle(d) {
      return d.keys().hasOnly(['tvClientId', 'tvClientSecret', 'pickerClientId', 'pickerApiKey', 'projectNumber', 'webClientSecret', 'updatedAt', 'updatedBy'])
          && (!('tvClientId' in d) || (d.tvClientId is string && d.tvClientId.size() <= 200))
          && (!('tvClientSecret' in d) || (d.tvClientSecret is string && d.tvClientSecret.size() <= 200))
          && (!('webClientSecret' in d) || (d.webClientSecret is string && d.webClientSecret.size() <= 200))
          && (!('pickerClientId' in d) || (d.pickerClientId is string && d.pickerClientId.size() <= 200))
          && (!('pickerApiKey' in d) || (d.pickerApiKey is string && d.pickerApiKey.size() <= 200))
          && (!('projectNumber' in d) || (d.projectNumber is string && d.projectNumber.size() <= 40))
          && (!('updatedAt' in d) || d.updatedAt is timestamp)
          && (!('updatedBy' in d) || (d.updatedBy is string && d.updatedBy.size() <= 120));
    }
    match /settings/{name} {
      allow get: if name == 'ai' || name == 'mypc' || name == 'google';
      allow create, update: if isAdmin() && ((name == 'ai' && validAi(request.resource.data)) || (name == 'mypc' && validMyPc(request.resource.data))
                                          || (name == 'google' && validGoogle(request.resource.data)));
      allow delete: if isAdmin();
    }

    // App counters for "Popular" in the App Store: anyone may add exactly 1 to one counter.
    function plusOne(f) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([f])
          && request.resource.data[f] == resource.data.get(f, 0) + 1;
    }
    match /appstats/{appId} {
      allow read: if true;
      allow create: if appId.matches('^[a-z0-9-]{2,32}$')
          && request.resource.data.keys().hasOnly(['installs', 'opens'])
          && request.resource.data.get('installs', 0) in [0, 1] && request.resource.data.get('opens', 0) in [0, 1];
      allow update: if request.resource.data.keys().hasOnly(['installs', 'opens']) && (plusOne('installs') || plusOne('opens'));
      allow delete: if isAdmin();
    }

    // A TV's backup (js/core/backup.js): profiles, settings, saves, installed apps, records, plus a summary
    // for the App Store Manager. The id is a hash of the TV's own id, so it cannot be guessed; anyone who
    // has it can read, replace or delete (Settings > Privacy) that one document. Only admins can list them all.
    function shortText(v, n) { return v is string && v.size() <= n; }
    function validTv(id, d) {
      return d.keys().hasOnly(['tv', 'src', 'model', 'version', 'build', 'lang', 'firstSeen', 'lastSeen',
                               'profiles', 'names', 'installed', 'top', 'blob', 'size'])
          && d.tv == id
          && shortText(d.src, 10) && shortText(d.model, 60) && shortText(d.version, 20) && shortText(d.lang, 5)
          && d.build is int && d.firstSeen is int && d.lastSeen is int && d.profiles is int && d.size is int
          && d.names is list && d.names.size() <= 8
          && d.installed is list && d.installed.size() <= 200
          && d.top is map && d.top.size() <= 100
          && d.blob is string && d.blob.size() <= 900000;
    }
    match /tvs/{tvId} {
      allow get, delete: if true;
      allow list: if isAdmin();
      allow create, update: if tvId.matches('^tv-[a-f0-9]{20,40}$') && validTv(tvId, request.resource.data);
    }

    // World records: the best 10 of each game on every My PC (js/core/world.js). Up to 10 small entries.
    function okEntry(l, i) {
      return l.size() <= i || (l[i] is map && l[i].keys().hasOnly(['n', 's', 'd', 'tv'])
          && shortText(l[i].n, 24) && l[i].s is int && l[i].s >= 0 && l[i].d is int && shortText(l[i].tv, 48));
    }
    match /records/{gameId} {
      allow read: if true;
      allow create, update: if gameId.matches('^[a-z0-9-]{2,40}$')
          && request.resource.data.keys().hasOnly(['list', 'updatedAt'])
          && request.resource.data.updatedAt is int
          && request.resource.data.list is list && request.resource.data.list.size() <= 10
          && okEntry(request.resource.data.list, 0) && okEntry(request.resource.data.list, 1) && okEntry(request.resource.data.list, 2)
          && okEntry(request.resource.data.list, 3) && okEntry(request.resource.data.list, 4) && okEntry(request.resource.data.list, 5)
          && okEntry(request.resource.data.list, 6) && okEntry(request.resource.data.list, 7) && okEntry(request.resource.data.list, 8)
          && okEntry(request.resource.data.list, 9);
      allow delete: if isAdmin();
    }

    // Error reports (js/core/reports.js, MyPC.report in the SDK): written by any My PC, read only by admins in the
    // App Store Manager > Errors. Small, checked fields; each one expires (TTL policy on `exp`, see firebase/SETUP.md).
    function validReport(d) {
      return d.keys().hasAll(['app', 'kind', 'msg', 'n', 'at', 'exp', 'tv'])
          && d.keys().hasOnly(['app', 'kind', 'msg', 'stack', 'src', 'stage', 'appv', 'sdk', 'n', 'at', 'exp', 'tv', 'model', 'ver',
                               'build', 'lang', 'user', 'where', 'ua', 'url'])
          && shortText(d.app, 40) && d.app.size() > 0
          && d.kind in ['load', 'start', 'failed', 'error', 'rejection', 'resource', 'handler', 'report', 'shell']
          && shortText(d.msg, 300) && d.msg.size() > 0
          && (!('stack' in d) || shortText(d.stack, 1500)) && (!('src' in d) || shortText(d.src, 200))
          && (!('stage' in d) || shortText(d.stage, 20)) && (!('appv' in d) || shortText(d.appv, 20))
          && (!('sdk' in d) || d.sdk is int) && d.n is int && d.n >= 1 && d.n <= 1000000
          && d.at is timestamp && d.exp is timestamp && d.exp < request.time + duration.value(32, 'd')
          && shortText(d.tv, 48) && (!('model' in d) || shortText(d.model, 60)) && (!('ver' in d) || shortText(d.ver, 20))
          && (!('build' in d) || d.build is int) && (!('lang' in d) || shortText(d.lang, 5)) && (!('user' in d) || shortText(d.user, 30))
          && (!('where' in d) || d.where in ['tv', 'apk', 'web']) && (!('ua' in d) || shortText(d.ua, 160)) && (!('url' in d) || shortText(d.url, 200));
    }
    match /errors/{reportId} {
      allow create: if reportId.matches('^[a-z0-9]{20}$') && validReport(request.resource.data);
      allow read, delete: if isAdmin();
    }

    // Rooms (lobbies) for apps and games: MyPC.rooms in the SDK. ONLY the My PC shell writes here (js/core/rooms.js);
    // apps never hold keys. There is no sign-in, so these documents are open to anyone who knows the project's web
    // config: keep them tiny, short-lived (every document has an `exp` timestamp, at most 90 s ahead, removed by TTL
    // policies: see firebase/SETUP.md) and never put anything private in them.
    //   rooms/{room}            { app, name, max, n, at, exp }
    //   rooms/{room}/reqs/{req} { name, offer, exp, answer?, no? }   offer / answer: opaque strings (WebRTC text)
    // Google Drive phone sign-in (js/core/gdrive.js phoneSignIn, drive-signin.html): the phone drops Google's one-time code
    // under a random 32 character id only it and the TV know; the TV reads it, trades it (with its PKCE verifier and the
    // client secret) and deletes it. No list. TTL policy on `exp` (firebase/SETUP.md) removes forgotten ones.
    match /gauth/{id} {
      allow get, delete: if id.matches('^[A-Za-z0-9_-]{32}$');
      allow create: if id.matches('^[A-Za-z0-9_-]{32}$')
          && request.resource.data.keys().hasOnly(['code', 'err', 'exp']) && request.resource.data.keys().hasAll(['exp'])
          && (!('code' in request.resource.data) || (request.resource.data.code is string && request.resource.data.code.size() <= 600))
          && (!('err' in request.resource.data) || (request.resource.data.err is string && request.resource.data.err.size() <= 60))
          && request.resource.data.exp is timestamp && request.resource.data.exp < request.time + duration.value(20, 'm');
    }

    function soon(t) { return t is timestamp && t > request.time - duration.value(20, 's') && t < request.time + duration.value(90, 's'); }
    function roomKey(k) { return k.matches('^[a-z0-9]{6,16}$'); }
    match /rooms/{room} {
      allow get: if roomKey(room);
      allow list: if request.query.limit <= 50;
      allow create: if roomKey(room)
          && request.resource.data.keys().hasOnly(['app', 'name', 'max', 'n', 'at', 'exp'])
          && request.resource.data.keys().hasAll(['app', 'name', 'max', 'n', 'at', 'exp'])
          && request.resource.data.app is string && request.resource.data.app.matches('^[a-z0-9-]{2,32}$')
          && shortText(request.resource.data.name, 24) && request.resource.data.name.size() > 0
          && request.resource.data.max is int && request.resource.data.max >= 2 && request.resource.data.max <= 8
          && request.resource.data.n == 1 && request.resource.data.at is int
          && soon(request.resource.data.exp);
      // the host's shell refreshes `exp` every 15 s and keeps the player count `n` up to date
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['exp', 'n'])
          && soon(request.resource.data.exp)
          && request.resource.data.n is int && request.resource.data.n >= 1 && request.resource.data.n <= request.resource.data.max;
      allow delete: if true;

      match /reqs/{req} {
        allow get: if roomKey(req);
        allow list: if request.query.limit <= 25;
        allow create: if roomKey(req) && exists(/databases/$(database)/documents/rooms/$(room))
            && request.resource.data.keys().hasOnly(['name', 'offer', 'exp'])
            && request.resource.data.keys().hasAll(['name', 'offer', 'exp'])
            && shortText(request.resource.data.name, 24) && request.resource.data.name.size() > 0
            && shortText(request.resource.data.offer, 6000) && request.resource.data.offer.size() > 0
            && soon(request.resource.data.exp);
        // the host's shell answers (or declines) once
        allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['answer', 'no'])
            && (!('answer' in request.resource.data) || (shortText(request.resource.data.answer, 6000) && request.resource.data.answer.size() > 0))
            && (!('no' in request.resource.data) || request.resource.data.no == true);
        allow delete: if true;
      }
    }

    // Share to the TV over the internet (js/launcher/share-rx.js, the phone's Send to TV in js/launcher/apps/receiver.js).
    // No sign-in: the TV's random 10 character code (about 50 bits, shown only on its screen) is the key. Anyone who knows it
    // can send to that TV, so the TV deletes each item once it opened it and a TTL policy on `items.exp` (the same one as the
    // push inbox, firebase/SETUP.md 4c) removes forgotten ones after a day. A photo is shrunk on the phone to fit one document.
    //   share/{tv}             { name, at, open }   the TV listens (written at start, every 5 min, open: false at stop)
    //   share/{tv}/items/{id}  { k, text?, n?, mime?, data?, u?, size?, from, at, exp }
    function shareKey(k) { return k.matches('^[2-9A-HJ-NP-Z]{10}$'); }
    function validShare(d) {
      return d.keys().hasAll(['k', 'from', 'at', 'exp'])
          && d.keys().hasOnly(['k', 'text', 'n', 'mime', 'data', 'u', 'size', 'from', 'at', 'exp'])
          && d.k in ['text', 'photo', 'file']
          && (!('text' in d) || shortText(d.text, 20000)) && (!('n' in d) || shortText(d.n, 120))
          && (!('mime' in d) || shortText(d.mime, 100)) && (!('data' in d) || shortText(d.data, 750000))
          && (!('u' in d) || (shortText(d.u, 300) && d.u.matches('^http://.*')))
          && (!('size' in d) || d.size is int) && shortText(d.from, 60) && d.at is int
          && d.exp is timestamp && d.exp < request.time + duration.value(2, 'd');
    }
    match /share/{tv} {
      allow get, delete: if shareKey(tv);
      allow create, update: if shareKey(tv)
          && request.resource.data.keys().hasOnly(['name', 'at', 'open']) && request.resource.data.keys().hasAll(['name', 'at', 'open'])
          && shortText(request.resource.data.name, 60) && request.resource.data.at is int && request.resource.data.open is bool;
      match /items/{id} {
        allow get, delete: if shareKey(tv) && id.matches('^[a-z0-9]{16,40}$');
        allow list: if shareKey(tv) && request.query.limit <= 10;
        allow create: if shareKey(tv) && id.matches('^[a-z0-9]{16,40}$') && validShare(request.resource.data);
        // the TV could not open it: it marks it `no` (the phone reads that, tells the user and deletes it)
        allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['no']) && request.resource.data.no == true;
      }
    }

    // Player accounts (js/core/accounts.js): a profile signed in with Firebase Authentication (username@players.mypc.app
    // + password). Only that account reads or writes its own copy: settings, saves and picture of the profile.
    // data.<game id>.<key> = a game's saves, settings.<key> = the rest. The old whole-profile blob string is refused
    // (My PC merges an old one into data and writes the doc again without it).
    function validPlayer(d) {
      return d.keys().hasOnly(['user', 'name', 'color', 'av', 'photo', 'blob', 'data', 'settings', 'size', 'at', 'from'])
          && shortText(d.user, 16) && shortText(d.name, 24) && shortText(d.color, 9)
          && (!('av' in d) || shortText(d.av, 20)) && (!('photo' in d) || shortText(d.photo, 30000))
          && shortText(d.from, 48) && d.data is map && (!('settings' in d) || d.settings is map)
          && (!('blob' in d) || shortText(d.blob, 20)) && d.size is int && d.size <= 900000 && d.at is int;
    }
    match /players/{uid} {
      allow get, delete: if signedIn() && request.auth.uid == uid;
      allow create, update: if signedIn() && request.auth.uid == uid && validPlayer(request.resource.data);
    }

    // Desktop widgets (App Store Manager > Widgets, installer/widgets.js; TV side js/launcher/widgets.js; sdk/GUIDE.md):
    // the approved copy of a widget's code, read by every TV that shows it (TVs never sign in), written only by admins.
    function validWidget(id, d) {
      return d.keys().hasOnly(['app', 'widget', 'code', 'sha', 'at', 'by'])
          && d.app is string && d.widget is string && id == d.app + '__' + d.widget
          && d.code is string && d.code.size() <= 60000
          && d.sha is string && d.sha.matches('^[0-9a-f]{64}$')
          && d.at is int && (!('by' in d) || (d.by is string && d.by.size() <= 120));
    }
    match /widgets/{id} {
      allow get: if true;
      allow create, update: if isAdmin() && id.matches('^[a-z0-9-]{2,32}__[a-z0-9-]{1,20}$') && validWidget(id, request.resource.data);
      allow delete: if isAdmin();
    }

    // Push notifications (App Store Manager > Services, installer/services.js; TV side js/core/push.js; sdk/GUIDE.md).
    // A player is the account <username>@players.mypc.app (js/core/accounts.js): their sign-in token carries that e-mail.
    function player(username) {
      return signedIn() && request.auth.token.email == username + '@players.mypc.app';
    }
    // the services' settings, approvals, state and the runner lease: admins only
    match /services/{id} {
      allow read, write: if isAdmin();
    }
    // opt-in: subs/<app>/users/<username> exists = this player allowed notifications from this app
    match /subs/{appId}/users/{username} {
      allow get, delete: if player(username) || isAdmin();
      allow list: if isAdmin();
      allow create, update: if player(username) && request.resource.data.keys().hasOnly(['at', 'app'])
          && request.resource.data.at is int && request.resource.data.app == appId;
    }
    // the inbox: written by the Manager (admins), read and emptied by that player only. TTL policy on exp (SETUP.md).
    function validItem(d) {
      return d.keys().hasAll(['app', 'title', 'at', 'exp'])
          && d.keys().hasOnly(['app', 'name', 'title', 'text', 'image', 'link', 'at', 'exp'])
          && d.app is string && d.app.size() <= 40
          && (!('name' in d) || (d.name is string && d.name.size() <= 40))
          && d.title is string && d.title.size() > 0 && d.title.size() <= 60
          && (!('text' in d) || (d.text is string && d.text.size() <= 200))
          && (!('image' in d) || (d.image is string && d.image.size() <= 300 && d.image.matches('^https://.*')))
          && (!('link' in d) || (d.link is string && d.link.size() <= 300))
          && d.at is int && d.exp is timestamp;
    }
    match /inbox/{username}/items/{id} {
      allow read, delete: if player(username) || isAdmin();
      allow create: if isAdmin() && validItem(request.resource.data);
    }

    // Admin list: each admin can only check their own entry; managed in the console only.
    match /admins/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    // Everything else is closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
