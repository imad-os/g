rules_version = '2';

// My PC (formerly Arcade): Firestore security rules.
//  - Anyone (the TVs) can READ the App Store catalog ("apps"). TVs never sign in.
//  - Only signed-in admins can publish / update / remove apps (App Store Manager, installer/index.html).
//  - TVs may write only small, checked things: +1 on an app's counters, their own backup document,
//    the world records (top 10 per game).
//  - An admin is a user whose UID has a document in /admins (created by hand in the console).
//  - Writes are validated so a mistake in the admin page cannot break every TV.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isAdmin() {
      return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // { en: '...', fr: '...', es: '...', ar: '...' }  (en required)
    function validText(t) {
      return t is map && t.keys().hasAll(['en']) && t.keys().hasOnly(['en', 'fr', 'es', 'ar'])
          && t.en is string && t.en.size() > 0 && t.en.size() <= 80;
    }

    function validGame(d) {
      return d.keys().hasAll(['title', 'url', 'enabled', 'order'])
          && d.keys().hasOnly(['title', 'description', 'url', 'cover', 'enabled', 'order', 'minShell',
                               'sdk', 'build', 'tags', 'bundled', 'updatedAt'])
          && validText(d.title)
          && (!('description' in d) || validText(d.description))
          // https only; bundled first-party games use a relative path like "games/jumper/"
          && d.url is string && d.url.size() <= 300
          && (d.url.matches('^https://[a-zA-Z0-9.-]+/.*') || d.url.matches('^games/[a-z0-9-]+/$'))
          && (!('cover' in d) || (d.cover is string && d.cover.size() <= 300))
          && d.enabled is bool
          && d.order is int && d.order >= 0 && d.order < 1000
          && (!('minShell' in d) || d.minShell is int)
          && (!('sdk' in d) || d.sdk is int)
          && (!('build' in d) || d.build is int)
          && (!('bundled' in d) || d.bundled is bool)
          && (!('tags' in d) || (d.tags is list && d.tags.size() <= 5))
          && (!('updatedAt' in d) || d.updatedAt is timestamp);
    }

    // Game list read by every TV (REST: .../documents/games)
    match /games/{gameId} {
      allow read: if true;
      allow create, update: if isAdmin() && gameId.matches('^[a-z0-9-]{2,32}$') && validGame(request.resource.data);
      allow delete: if isAdmin();
    }

    function httpsUrl(u) { return u is string && u.size() <= 400 && u.matches('^https://[a-zA-Z0-9.-]+(:[0-9]+)?/.*'); }

    // My PC installed apps (installer/index.html): an app or game built with the My PC SDK.
    function validApp(id, d) {
      return d.keys().hasAll(['id', 'name', 'url', 'entry', 'type', 'enabled', 'order'])
          && d.keys().hasOnly(['id', 'name', 'description', 'url', 'entry', 'icon', 'type', 'version', 'sdk',
                               'scores', 'enabled', 'order', 'installedAt', 'installedBy', 'config'])
          && d.id == id
          && d.name is string && d.name.size() > 0 && d.name.size() <= 40
          && (!('description' in d) || (d.description is string && d.description.size() <= 120))
          && httpsUrl(d.url) && httpsUrl(d.entry)
          && (!('icon' in d) || d.icon == '' || httpsUrl(d.icon))
          && d.type in ['game', 'app']
          && (!('version' in d) || (d.version is string && d.version.size() <= 20))
          && (!('sdk' in d) || d.sdk is int)
          && (!('scores' in d) || d.scores is bool)
          && d.enabled is bool
          && d.order is int && d.order >= 0 && d.order < 1000
          && (!('installedAt' in d) || d.installedAt is timestamp)
          && (!('installedBy' in d) || d.installedBy is string)
          && (!('config' in d) || d.config is map);
    }

    // The App Store catalog, read by every TV (REST: .../documents/apps), written only by admins.
    match /apps/{appId} {
      allow read: if true;
      allow create, update: if isAdmin() && appId.matches('^[a-z0-9-]{2,32}$') && validApp(appId, request.resource.data);
      allow delete: if isAdmin();
    }

    // App counters for "Popular" in the App Store: anyone may add exactly 1 to one counter.
    function plusOne(f) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([f])
          && request.resource.data[f] == resource.data.get(f, 0) + 1;
    }
    match /appstats/{appId} {
      allow read: if true;
      allow create: if appId.matches('^[a-z0-9-]{2,32}$')
          && request.resource.data.keys().hasOnly(['installs', 'opens'])
          && request.resource.data.get('installs', 0) in [0, 1] && request.resource.data.get('opens', 0) in [0, 1];
      allow update: if request.resource.data.keys().hasOnly(['installs', 'opens']) && (plusOne('installs') || plusOne('opens'));
      allow delete: if isAdmin();
    }

    // A TV's backup (js/core/backup.js): profiles, settings, saves, installed apps, records, plus a summary
    // for the App Store Manager. The id is a hash of the TV's own id, so it cannot be guessed; anyone who
    // has it can read, replace or delete (Settings > Privacy) that one document. Only admins can list them all.
    function shortText(v, n) { return v is string && v.size() <= n; }
    function validTv(id, d) {
      return d.keys().hasOnly(['tv', 'src', 'model', 'version', 'build', 'lang', 'firstSeen', 'lastSeen',
                               'profiles', 'names', 'installed', 'top', 'blob', 'size'])
          && d.tv == id
          && shortText(d.src, 10) && shortText(d.model, 60) && shortText(d.version, 20) && shortText(d.lang, 5)
          && d.build is int && d.firstSeen is int && d.lastSeen is int && d.profiles is int && d.size is int
          && d.names is list && d.names.size() <= 8
          && d.installed is list && d.installed.size() <= 200
          && d.top is map && d.top.size() <= 100
          && d.blob is string && d.blob.size() <= 900000;
    }
    match /tvs/{tvId} {
      allow get, delete: if true;
      allow list: if isAdmin();
      allow create, update: if tvId.matches('^tv-[a-f0-9]{20,40}$') && validTv(tvId, request.resource.data);
    }

    // World records: the best 10 of each game on every My PC (js/core/world.js). Up to 10 small entries.
    function okEntry(l, i) {
      return l.size() <= i || (l[i] is map && l[i].keys().hasOnly(['n', 's', 'd', 'tv'])
          && shortText(l[i].n, 24) && l[i].s is int && l[i].s >= 0 && l[i].d is int && shortText(l[i].tv, 48));
    }
    match /records/{gameId} {
      allow read: if true;
      allow create, update: if gameId.matches('^[a-z0-9-]{2,40}$')
          && request.resource.data.keys().hasOnly(['list', 'updatedAt'])
          && request.resource.data.updatedAt is int
          && request.resource.data.list is list && request.resource.data.list.size() <= 10
          && okEntry(request.resource.data.list, 0) && okEntry(request.resource.data.list, 1) && okEntry(request.resource.data.list, 2)
          && okEntry(request.resource.data.list, 3) && okEntry(request.resource.data.list, 4) && okEntry(request.resource.data.list, 5)
          && okEntry(request.resource.data.list, 6) && okEntry(request.resource.data.list, 7) && okEntry(request.resource.data.list, 8)
          && okEntry(request.resource.data.list, 9);
      allow delete: if isAdmin();
    }

    // Admin list: each admin can only check their own entry; managed in the console only.
    match /admins/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    // Everything else is closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
